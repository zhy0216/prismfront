{
  "$schema": "https://biomejs.dev/schemas/2.5.7/schema.json",
  "root": true,
  "vcs": { "enabled": true, "clientKind": "git", "useIgnoreFile": true },
  "files": {
    "ignoreUnknown": true,
    "includes": [
      "**",
      "!**/node_modules",
      "!**/dist",
      "!**/.turbo",
      "!**/coverage",
      "!**/reports",
      "!**/bun.lock",
      "!apps/client/src/generated"
    ]
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 100,
    "lineEnding": "lf"
  },
  "linter": {
    "enabled": true,
    "rules": { "preset": "recommended" }
  },
  "assist": {
    "enabled": true,
    "actions": { "source": { "preset": "recommended" } }
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "double",
      "semicolons": "always",
      "trailingCommas": "all",
      "arrowParentheses": "always"
    }
  },
  "json": {
    "parser": { "allowComments": false, "allowTrailingCommas": false },
    "formatter": { "enabled": true }
  },
  "overrides": [
    {
      "includes": ["**/turbo.json", "**/tsconfig*.json", "**/*.jsonc", "**/.vscode/**"],
      "json": { "parser": { "allowComments": true, "allowTrailingCommas": true } }
    },
    {
      "includes": ["package.json", "tsconfig.base.json"],
      "formatter": { "enabled": false },
      "json": { "parser": { "allowComments": true, "allowTrailingCommas": true } }
    }
  ]
}
