{
  "name": "@prismfront/cli",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts"
  },
  "dependencies": {
    "@prismfront/ir": "workspace:*",
    "@prismfront/cards": "workspace:*",
    "@prismfront/engine": "workspace:*",
    "@prismfront/bot": "workspace:*",
    "@prismfront/shared": "workspace:*"
  },
  "devDependencies": {
    "@types/bun": "1.3.14"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "lint": "biome check .",
    "ir:print": "bun run src/ir/print.ts",
    "ir:diff": "bun run src/ir/diff.ts",
    "sim": "bun run src/index.ts sim"
  }
}
